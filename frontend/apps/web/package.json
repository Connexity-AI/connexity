{
  "name": "connexity",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "generate-client": "openapi-ts",
    "standalone": "pnpm cp && node .next/standalone/apps/web/server.js",
    "cp": "cp -r public .next/standalone/apps/web/ && cp -r .next/static .next/standalone/apps/web/.next/",
    "format": "prettier --write \"**/*.{js,ts,tsx,md,json}\"",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "check-types": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@hookform/resolvers": "5.2.2",
    "@tanstack/react-query": "5.96.2",
    "@tanstack/react-query-devtools": "5.100.8",
    "@workspace/ui": "workspace:*",
    "lucide-react": "0.562.0",
    "next": "16.2.0",
    "next-public-env": "1.1.0",
    "next-themes": "0.4.6",
    "nuqs": "2.8.9",
    "object-treeify": "5.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "7.71.2",
    "zod": "4.3.5"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.88.0",
    "@types/node": "25.0.3",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/set-cookie-parser": "2.4.10",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "9.39.2",
    "typescript": "5.9.3"
  }
}
